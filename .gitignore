# Ignore Python's cache files
__pycache__/
*.pyc

# Ignore the large, locally-generated vector database
# The user should generate this themselves by running ingest.py
chroma_db/

# Ignore user data files but keep the README
data/*
!data/README.md

# Ignore user-specific conversation logs
conversations/

# Ignore virtual environment folders (if you ever use them)
venv/
.venv/

# Ignore IDE-specific folders
.vscode/
.idea/

# Ignore user-specific config overrides
config.local.yaml

# Ignore log files
*.log
logs/
# Ignore Python's cache files
__pycache__/
*.pyc

# Ignore the large, locally-generated vector database
# The user should generate this themselves by running ingest.py
chroma_db/

# Ignore user data files but keep the README
data/*
!data/README.md

# Ignore user-generated content
conversations/
notes/
flashcards/
memory/
output/
exports/
uploads/

# Ignore database files
*.db
*.db-journal

# Ignore virtual environment folders
venv/
.venv/
env/

# Ignore IDE-specific folders
.vscode/
.idea/

# Ignore user-specific config overrides
config.local.yaml
.env
.env.local

# Ignore log files
*.log
logs/

# Ignore frontend build artifacts
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/build/

# Ignore Docker volumes
.docker/

# Ignore OS files
.DS_Store
Thumbs.db
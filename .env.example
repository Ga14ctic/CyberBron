# CyberBron Backend Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Security (IMPORTANT: Change these in production!)
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8501,http://127.0.0.1:3000

# Database
DATABASE_URL=sqlite+aiosqlite:///./cyberbron.db
# For PostgreSQL: postgresql+asyncpg://user:password@localhost/cyberbron
# For MySQL: mysql+aiomysql://user:password@localhost/cyberbron

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:latest
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Storage Paths
DATA_DIR=data
CHROMA_DB_DIR=chroma_db
UPLOAD_DIR=uploads
EXPORT_DIR=exports
OUTPUT_DIR=output

# Feature Flags
ENABLE_WEB_SEARCH=True
ENABLE_MEMORY=True
ENABLE_RATE_LIMITING=True

# Content Generation Limits
MAX_FLASHCARDS_PER_REQUEST=20
MAX_QUIZ_QUESTIONS=50
MAX_PRESENTATION_SLIDES=30

# Pearson T-Level Integration
PEARSON_SPEC_URL=https://qualifications.pearson.com/content/dam/pdf/T-Level/digital-production-design-development/2020/specification/Digital-TLevel-Specification-Issue-4.pdf
PEARSON_SPEC_PATH=data/pearson_cybersecurity_spec.pdf
